for item in disabledBaubles {
    craftingTable.remove(item);
    furnace.remove(item);
    blastFurnace.remove(item);
    smoker.remove(item);
    campfire.remove(item);
    smithing.remove(item);
    loot.modifiers.register(
        "disable_bountifulbaubles_" + item.registryName.path,
        LootConditions.none(),
        CommonLootModifiers.remove(item)
    );
}