	quest.3091985C0E95C53F.quest_desc: [
		"A Master Cartographer may offer a map to this structure, or it may appear naturally in the world."
		""
		"During an air raid in World War II, Shizue Izawa was summoned to another world by &4Demon Lord Leon Cromwell&r. Her body could not withstand the otherworld's Magicules, and she was close to death."
		""
		"To save her, Leon forcibly fused the Fire Spirit \"Ifrit\" into her body, turning her into a \"Fire Flame Demon.\" Ifrit was not fully under control and could sometimes take over Shizue's consciousness, transforming her into a destructive flame monster."
		"{image:ablazeaqzlcz:textures/ftb/ifrit_shizu.png width:100 height:100 align:center}"
		""
		"To &bfree Shizue Izawa&r, you must defeat &4the Fire Spirit Ifrit&r."
	]
	quest.3091985C0E95C53F.quest_subtitle: "Fire Flame Demon"
	quest.3091985C0E95C53F.title: "&6【Challenge Line ①】&r A Person from Another World Who Hates Slimes..."
	quest.309779606351AC6A.quest_subtitle: "Stores kinetic stress for later use. Retains charge in item form to enable long-distance energy transport. Battery capacity, RPM at discharge and stress impact values are all configurable"
	quest.309779606351AC6A.title: "&cKinetic Battery"
	quest.30A3566EB22079CA.quest_desc: [
		"&6Important materials for synthesizing puppets"
		""
		"When you have attachments or skills, you can use these puppets as your new body, and the player's race and magic power will not be affected if they inherit the health of the bone puppets."
		"&8For example: 20 blood → inherit 400 blood and bone puppet, you can get a body with 400 blood"
		""
		"If killed, the bone golem returns to the inventory"
	]
	quest.30A3566EB22079CA.quest_subtitle: "Make a puppet."
	quest.30C4FEDFA9A5DB16.quest_desc: [
		"&6Note: Do not use skills while a cutscene is playing, as it may cause the skills in your hotbar to be cleared."
		""
		"Generate on the castle structure in the overworld."
	]
	quest.30C4FEDFA9A5DB16.quest_subtitle: "Dragon at the Castle"
	quest.30CF131DFA9D542D.quest_subtitle: "Transfer stress capacity from one network to another while keeping the networks separate. Guarantees that the source network will not be affected when the destination network is overstressed"
	quest.30CF131DFA9D542D.title: "&bKinetic Bridge"
	quest.30D5CEA810CE1978.quest_subtitle: "A &6Spout&r is used for filling items with fluids and crafting certain items using fluids"
