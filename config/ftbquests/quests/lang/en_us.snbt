	quest.313C7B20500ED01E.quest_desc: [
		"Don't like a &e&lUnique Skill Book&r you were given? &oNot an issue.&r"
		""
		"For the low price of 40 gold coins &7(only 30% the cost of rolling for another Unique Skill)&r, you can reroll a Unique Skill Book into another."
	]
	quest.313C7B20500ED01E.quest_subtitle: "Our Unique Skill guarantee."
	quest.313C7B20500ED01E.title: "&#FF6854【Recycle】&f Unique Skills"
