	quest.033E7759B64F002C.quest_desc: [
		"How to obtain: Use a Slime's Absorb & Dissolve, Predator, or another skill-extracting ability on a Hover Lizard, Leech Lizard, or Tempest Serpent."
		""
		"&l[Passive - Toggle]:&r When toggled on, entities marked as \"warm-blooded\" within a 20-block radius are highlighted with a red outline. Entities marked as cold-blooded are not displayed at all, while entities marked as cold sources (such as Snow Golems) have a cyan outline. Does not work in the Nether."
	]
	quest.033E7759B64F002C.quest_subtitle: "Enemy detected at the marker."
	quest.033E7759B64F002C.title: "&6【Tips】&r Obtain 【Sense Heat Source】"
