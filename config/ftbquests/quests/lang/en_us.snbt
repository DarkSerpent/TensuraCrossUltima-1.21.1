	quest.29A111B8AA05196C.quest_desc: ["To enter Twilight Forest, you need a magic ore fragment and use a 2×2 square pool surrounded by flowers to throw the magic ore fragment into it to activate the portal."]
	quest.29A111B8AA05196C.quest_subtitle: "You need a shard of magic ore."
	quest.29BA350ABCC8B70E.quest_subtitle: "&bDemanding Dish"
	quest.29BC2181C9AC3A60.quest_desc: ["Needs to rotate at at least &630 RPM&r to function"]
	quest.29BC2181C9AC3A60.quest_subtitle: "A &6Mechanical Mixer&r can autocraft shapeless recipes as well as mix things like potions"
	quest.29BC2181C9AC3A60.title: "Obtain Mechanical Mixer"
	quest.29D5A0C139127B44.quest_desc: [
		"You can meet it under the temple by the sea"
		""
		"&8Its eyes are enough to kill you, no matter how powerful you are..."
		"&8you can synthesize one&6eye mask&r&8to cover their eyes, but experienced adventurers usually lower their heads to attack it."
	]
	quest.29D5A0C139127B44.quest_subtitle: "Don't stare into its eyes!"
	quest.29D5A0C139127B44.title: "Kill the Gorgon Medusa"
	quest.29D96A1CE4910C8B.quest_desc: "&6Dropped by Rimuru, Supermassive Slime, and Lumisdin. &rConsuming it grants 10 minutes of accelerated skill learning. If you have Great Sage, Sage, or King of Wisdom, it also increases some proficiency. If you have King of Wisdom, consuming 10 of these lets you lock this Ultimate Skill on the \"Lock\" screen, preventing it from being lost through reincarnation."
	quest.29F3FCDB8B20E164.quest_subtitle: "A gearbox with shafts on all 6 sides. Conceptually uses the same internal mechanism as Parallel Gearbox, so top and bottom spins at half speed"
	quest.29F3FCDB8B20E164.title: "&6The 6-way Gearboxes"
	quest.2A243EB62B7E854E.title: "Defeat the Iron Palm of the Nether"
	quest.2A28C48839DFA9E9.quest_desc: [
		"D-level grimoires will drop from chests in various wizard towers:"
		""
		"Ruined Wizard Tower"
		"Rotted Wizard Tower"
		"Frozen Wizard Tower"
		"Buried Wizard Tower"
		"Burnt Wizard Tower"
		""
		"Or in the magic trainer house chest in the dwarf village"
	]
	quest.2A45646F93259D25.quest_subtitle: "The &6Gearbox&r is sort of like an extension cord, but for &6Shafts&r. It can change the direction of shafts, and can have more than one shaft attached to a different side of the gearbox"
