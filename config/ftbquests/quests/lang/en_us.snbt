	quest.6A590E454F0BCF51.quest_subtitle: "Search for the structure."
	quest.6A60B76053393288.quest_desc: ["The Smeltery is where the Smelter will smelt ores into ingots. The higher the level of the Smeltery, the more furnaces the Smelter will be able to use. A higher level will also have a higher chance to double and even triple the ingot output per block of ore."]
	quest.6A60B76053393288.quest_subtitle: "Builder a Smelter"
	quest.6A6CABAF79536A2E.title: "{translate:\"task.9C0D1E2F3A4B5679.title\"}"
	quest.6A7CDF204DB01A20.quest_subtitle: "A &6Mechanical Roller&r lets you clear blocks in front and pave with desired blocks underneath the tracks while riding a train"
	quest.6A7CDF204DB01A20.title: "&6Mechanical Roller"
	quest.6AAB6D0E51DB699C.quest_desc: [
		"1. Gain EP while blinded to unlock this Skill."
		"2. Alternatively, craft and eat a \"&5Mystery Stew&r,\" then kill a creature to gain EP and unlock Danger Sense. Once you have learned the Skill, hold its assigned key to use it. The Skill grants&6night vision and biosensing&r."
		"3. Some races have this Skill innately."
		""
		"Once you have mastered this Skill, use the switch in the Skill panel to enable its background mode."
		"&6(This Skill may also reveal magic ores!)"
	]
	quest.6AAB6D0E51DB699C.quest_subtitle: "Night vision!"
	quest.6AAB6D0E51DB699C.title: "&6【Helpful Tip】&r An Essential Early-Game Skill: [Magic Sense]"
