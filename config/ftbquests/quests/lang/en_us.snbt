	]
	quest.46FF849AF3C24F9E.quest_subtitle: "Complete Body, Perfect Medicine Refining Material"
	quest.47214EC2867A9B30.quest_desc: [
		"In the Underworld, you may encounter a certain “special” demon."
		"Unlike demons driven only by slaughter, consumption, and conflict, he is remarkably elegant and composed. He does not readily attack the weak, nor does he display his power without purpose. Yet when he truly turns his gaze upon you, you will understand—the being before you is no ordinary demon. His jet-black silhouette, unfathomable magicules, and instinctively terrifying presence all reveal his true identity. He is one of the ancient Primordial Demons."
		"&c“Black”—Diablo.&r"
	]
	quest.47214EC2867A9B30.title: "&fDefeat &6【Diablo】"
	quest.477E6B9A9E264637.title: "Obtain Portable Drill"
	quest.47945DBEFB4C8D26.quest_subtitle: "【Mastery】"
	quest.47945DBEFB4C8D26.title: "&6【Advanced】&f Obtain the Unique Skill Infinity Prison"
	quest.47C041D061CC6669.quest_desc: ["After taming a Tensura creature, right-click it with this saddle to equip it."]
	quest.47C041D061CC6669.quest_subtitle: "Worn on the \"war knight\"."
	quest.47DEE3D24B6F2A90.quest_subtitle: "Absorb nearby moss and convert it into Aura."
