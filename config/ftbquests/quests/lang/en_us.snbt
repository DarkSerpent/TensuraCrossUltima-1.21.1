	quest.24A42438DA227224.quest_desc: [
		"&6&lTENSURA CROSS ULTIMA"
		"&6&nKEYBIND TUTORIAL"
		""
		"&7Default controls from the modpack. You can change any of these in &bMinecraft's Options > Controls > Key Binds&7."
		""
		"&e&lABILITIES \\& SKILLS"
		""
		"&6Z / X / C &f- Activate Ability slots 1, 2, and 3. First select or assign abilities in the Status Menu. These are ability activations, not three universal skills every character automatically has."
		""
		"&6Left Alt + Z / X / C &f- Cycle to the next ability mode. The selected mode can change how an ability slot behaves. Left Alt also activates Shoulder Surfing's free-look, so that action may overlap."
		""
		"&6CTRL + Variable &f- Use your scroll wheel or the 1-9 buttons to swap to your different saved Skill Hotbars."
		""
		"&6L &f- Use your Race/Mount Ability. A racial ability is a special action supplied by your race; what it does depends on your race and available ability. While mounted, this key may instead activate the mount's ability."
		""
		"&6B &f- Open the Status Menu to view your character's Tensura information and manage abilities."
		""
		"&6N &f- Open the Naming action/menu. Allows you to bestow a creature that you've tamed a Name. Also works when you reduce a creature's will to fight via combat, or when you cause them such intense fear they forcefully submit to you."
		""
		"&6Shift + N &f- Enabled the ability for other players to Name you, granting you a portion of their power but locking you into a subordinate contract with them."
		""
		"&6Mouse 3 &f- Combat Dodge. A small leap in any direction that can be used to avoid attacks."
		""
		"&e&lQUESTS, BACKPACK \\& MAP"
		""
		"&6Keypad 3 &f- Open your Quests Book, the thing you're reading right now."
		""
		"&6Keypad 1 &f- Open your Sophisticated Backpack. This requires you have a backpack equipped or in your inventory."
		""
		"&6M &f- Open the World Map."
		""
		"&6Y &f- Open your Minimap settings. The minimap itself is displayed on-screen."
		""
		"&6J &f- Create a new waypoint."
		""
		"&6U &f- Open the waypoint list."
		""
		"&6Mouse Button 4 &f- Ping a location with Ping Wheel (usually the side button near your thumb). If your mouse has no extra buttons, rebind it in Controls."
		""
		"&e&lVOICE CHAT"
		""
		"&6Caps Lock &f- Push to talk: hold the key while speaking."
		""
		"&6. (Period) &f- Open the Simple Voice Chat menu."
		""
		"&6' (Apostrophe) &f- Toggle your microphone mute."
		""
		"&6\\ (Backslash) &f- Disable or re-enable voice chat."
		""
		"&6, (Comma) &f- Open voice chat group controls."
		""
		"&e&lA FEW OTHER USEFUL CONTROLS"
		""
		"&6E &f- Open your inventory."
		""
		"&6Q &f- Drop the item you are holding."
		""
		"&6F &f- Swap the item in your main hand with your offhand."
		""
		"&6F2 &f- Take a screenshot."
		""
		"&6F5 &f- Change camera perspective."
		""
		"&6Ctrl + O &f- Toggle JEI's recipe/item list."
		""
		"&6R &f- View a JEI recipe for the item under the cursor; use the JEI controls for related recipes and uses."
		""
		"&6&lTip:&r &eKey names above describe the default pack settings. Your keyboard layout, mouse, or a later config change may display a different key in-game."
	]
	quest.24A42438DA227224.quest_subtitle: "【Must-See Content】"
	quest.24A44C95A35D658D.quest_desc: [
		"Your weapons manipulate EP in two ways..."
		""
		"&6First: &fThey automatically regenerate durability every second, depending on how much EP they have stored."
		""
		"&6Second: &fThey will evolve into their next stage once they reach the threshold of their EP"
	]
	quest.24A44C95A35D658D.quest_subtitle: "Your weapons are living instruments. Grow with them."
	quest.24A44C95A35D658D.title: "The Evolution of Weapons"
