	quest.5A54C9E87F1CE967.quest_desc: [
		"&#FFED54Hyperlink:&r"
		"[ { \"text\": \"How Artifacts Work\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"4DB740093C0BA804\" } } ]"
		""
		"Default Effects"
		"&5Effect 1: Rapid Incantation"
		"Increases magic casting speed by 10%."
		"This effect is active while the artifact is equipped and the effect is unlocked."
		"&5Effect 2: Flow of Mastery"
		"Increases ability mastery speed by 100%."
		"This effect is active while the artifact is equipped and the effect is unlocked."
		""
		"Refinement Bonuses"
		"Rapid Incantation Scaling"
		"Each refinement allocated to Rapid Incantation increases magic casting speed by an additional 2%."
		"Maximum: At +5 refinement, Rapid Incantation can increase magic casting speed by up to 20%."
		"Flow of Mastery Scaling"
		"Each refinement allocated to Flow of Mastery increases mastery speed by an additional 10%."
		"Maximum: At +5 refinement, Flow of Mastery can increase ability mastery speed by up to 150%."
	]
