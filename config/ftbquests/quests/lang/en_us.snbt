	quest.553FAC18CEC86043.title: "Water Elf•Intermediate"
	quest.55465CA3AEA7E0F1.quest_desc: [
		"&lGed&r"
		"He was originally a prince of the pig people. In order to save his people who were on the verge of extinction due to famine, he accepted the temptation of the Demon Lord Jester and swallowed the Demon Lord's seed, thus evolving into the \"Pig-headed Emperor\"."
		""
		"When he swallows enough creatures and his EP reaches 210,000, he will evolve into&l&4“Orc Disaster”&r&r"
	]
	quest.55465CA3AEA7E0F1.quest_subtitle: "Eat and kill, all to satisfy my hunger."
	quest.555508F1582AF26C.title: "&eCandy Cane Shovel"
	quest.55851524FDDB6959.quest_desc: ["The Cookery is where the Chef prepares meals for your citizens. When other buildings request food, the Chef will cook it. Pair the Cookery with your Restaurants to automatically keep them stocked with fresh meals."]
	quest.5596BF6D6FA66FCD.quest_subtitle: "&bDemanding Dish"
	quest.55F22AB5B4C881EF.quest_subtitle: "&7Common"
	quest.55F22AB5B4C881EF.title: "Catch Cod"
