	quest.5C4E0D0411A674BB.quest_desc: ["&lAfter he evolves to the Orc Disaster stage, he will have a unique Skill--&5The hungry&r&r"]
	quest.5C4E0D0411A674BB.quest_subtitle: "\"Help Gade\""
	quest.5C4E0D0411A674BB.title: "Defeat! Orc Disaster"
