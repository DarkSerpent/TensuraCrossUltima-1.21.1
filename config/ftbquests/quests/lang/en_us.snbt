	quest.6672D8CE0007FBFB.quest_desc: [
		"The &dResplendent Prism&f goes on your necklace slot and raises the enchantment levels on the gear you're holding and wearing."
		""
		"Its bonuses are rolled when it's crafted."
		""
		"Some add levels to enchantments you already have, some add new ones, and rarely one raises everything. Put it back in the altar to reroll it, replacing the old bonuses."
	]
	quest.6672D8CE0007FBFB.title: "&dResplendent Prism"
