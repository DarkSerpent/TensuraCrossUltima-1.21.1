	quest.7B21752E363AC030.quest_desc: [
		"The &3Containment Chalice&f stores a large amount of one liquid, shown floating over the bowl. Pipes connect underneath."
		""
		"An empty chalice, or one holding &bLiquid Starlight&f, pulls starlight from nearby &aLightwells&f as long as nothing blocks the way."
		""
		"Altars and the &3Starlight Infuser&f drain chalices in range the same way, so a couple next to your altar removes the need for buckets."
	]
	quest.7B21752E363AC030.title: "&3Containment Chalice"
	quest.7B2FA029F6718D6F.quest_desc: ["The Gaia Mana Spreader is an upgraded mana spreader for handling powerful mana bursts. Add it to your network to move mana between Botania devices."]
	quest.7B2FA029F6718D6F.quest_subtitle: "A powerful mana spreader"
	quest.7B2FA029F6718D6F.title: "Gaia Mana Spreader"
	quest.7B3CB2920C4FA0A0.quest_desc: ["Use the Eye of the Beast to locate this terrifying Piglin fortress in the Nether."]
	quest.7B3CB2920C4FA0A0.quest_subtitle: "War Puppet Foundry"
	quest.7B3CB2920C4FA0A0.title: "Go to Soul Forge"
