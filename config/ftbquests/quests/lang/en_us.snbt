	quest.30FB66CFE70278AD.quest_desc: "&6Trade with the Time Warden to obtain coordinates to this location."
	quest.30FB66CFE70278AD.quest_subtitle: "The Guardian Vault seals away the dimension's oldest defense core."
	quest.3103AA1D921B71BC.quest_subtitle: "As the name implies, &aSuper Glue&r allows you to glue blocks together. Particularly useful when making contraptions"
	quest.3103AA1D921B71BC.title: "&aSuper Glue"
	quest.31148C0753B498F2.quest_subtitle: "&7Simple Fare"
	quest.31179AE571AD06FD.quest_desc: ["You may have discovered that villagers don't have a use for your emeralds in our modern day. No worries. The &eArmored Nation of Dwargon&r always has a use for them."]
	quest.31179AE571AD06FD.quest_subtitle: "It's quite the good deal."
	quest.31179AE571AD06FD.title: "&#FF6854【Recycle】&f We Buy Emeralds"
