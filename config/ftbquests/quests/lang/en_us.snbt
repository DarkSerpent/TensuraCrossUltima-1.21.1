	quest.07BCD842AEA4A0C4.title: "{translate:\"task.AA1B2C3D4E5F6780.title\"}"
	quest.07C26C046CDE2507.quest_desc: ["The Crusher’s Hut is where the Crusher will take items and crush them into other blocks. Most notably cobblestone = gravel, gravel = sand, sand = clay. One important factor to know is that the crusher has a daily limit based on the hut level. Level 1 has a daily max of 16, level 2 has 64. At level 5 it’s daily max is 999. "]
	quest.07C26C046CDE2507.quest_subtitle: "Build a Crusher's Hut"
	quest.07D69899C52591E9.quest_desc: [
		"It has three stages. Each time its health drops by one-third, it enters the next stage."
		"&6The skills it possesses are fire attack negation, heat negation, abnormal status negation, body strengthening and steel power."
		""
		"The Blazing Frenzied Soul can be spawned in the Nether Fortress after defeating it."
	]
	quest.07D69899C52591E9.quest_subtitle: "Lord of Fire"
	quest.07D69899C52591E9.title: "Defeat the Flame Demon"
	quest.07E64C0B306DB76F.quest_desc: [
		"To evolve into a Demon Lord, you need 10,000 souls. Souls are obtained by killing creatures; creatures with higher EP grant more souls."
		""
		"&lEvolution benefits&r"
		"Grants &43× EP&r."
		"&bDoubles&r ally attributes."
		"Some NPC allies also evolve."
		"&5Resistance Evolution&r does not apply."
		""
		"&6Tip: Gather EP before evolving. Once you have enough, evolving into a Demon Lord will double its value.&r"
		""
		"Before awakening, you will undergo a three-minute &6Harvest Festival&r:"
		""
		"During the first minute, you cannot use Skills, and your vision and movement are limited. Followers in range automatically switch to \"Follow and Protect.\""
		""
		"During the second minute, you enter \"sleep mode.\""
		""
		"During the final minute, your followers and monster allies in range also enter \"sleep mode.\""
		"As the ritual ends, its sound and visual effects intensify. During the final 10 seconds, you begin to blink and slowly rise into the air as the awakening completes."
	]
	quest.07E64C0B306DB76F.quest_subtitle: "Kill!"
	quest.07E64C0B306DB76F.title: "&6【Demon Lord Route】&r Conditions for Becoming a Demon Lord"
	quest.07EC5E450BA9712D.quest_subtitle: "A &6Depot&r is really just a belt that doesn't move"
	quest.07EC5E450BA9712D.title: "Obtain Depot"
	quest.0809979A30FA5C6E.quest_subtitle: "&7Simple Fare"
	quest.080F3F29AE3A1EDF.quest_desc: "This item may drop from demons in the Netherworld or be found in chests in the Nether."
	quest.080F3F29AE3A1EDF.quest_subtitle: "How to Obtain"
	quest.0813F465C4661060.title: "Small Poison Taratect"
	quest.081BC6F954D95C8A.quest_subtitle: "A kinetic source that uses the power of the wind to generate rotational force. The amount of &6SU&r generated depends on the number of sails connected to the &6Windmill&r and maxes out at 8,192 per bearing"
	quest.081BC6F954D95C8A.title: "Windmill Bearing"
	quest.0831BD175FEF3A79.quest_desc: [
		"&l&6First, locate the three Skill slots on the left. If they are hidden, open the personal information panel (B key), then click the gear button in the upper-right corner.&r"
		"{image:ablazeaqzlcz:textures/ftb/interface.png width:145 height:100 align:center}"
	]
	quest.0831BD175FEF3A79.quest_subtitle: "Component position (you don’t need to adjust it if it’s not in the way)."
	quest.0831BD175FEF3A79.title: "Step One: Screen Adjustment"
	quest.084FC80D83382D73.quest_subtitle: "The underground fortress lies within it [Choose a route; solo players can challenge them all]."
	quest.085F473094778DCD.quest_desc: [
		"The resource scroll is an easy way to tell what one of your Builder needs. Sneak + right-click on a Builder’s Hut to register the resource scroll to the builder."
		""
		"Now when you right-click while holding the resource scroll, you will see all the needed materials for the Builder’s Hut you clicked on."
	]
	quest.085F473094778DCD.quest_subtitle: "Micromanagement at it's finest"
