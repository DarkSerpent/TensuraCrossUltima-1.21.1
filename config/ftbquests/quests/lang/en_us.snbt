	quest.5C06C41DE2914409.title: "&6Reforging and Enhancement"
	quest.5C1916C1CDFAD8A1.quest_desc: ["Restores 20% MP after drinking"]
	quest.5C1916C1CDFAD8A1.quest_subtitle: "Obtained from the alchemy dwarf."
	quest.5C209FD2F233F045.quest_subtitle: "&2Uncommon"
	quest.5C209FD2F233F045.title: "Catch Endergazer"
