	quest.4521C5CD54579EBA.quest_subtitle: "Applies to “Reset Counter”."
	quest.45240C873BEAD3EF.quest_desc: ["With these awesome armor pieces you can &bBounce from place to place&r using your &aSlime Boots&r or &eCling to the ceiling&r with your &aSlime Helmet&r the helmet also allows you to &dBounce off walls&r if you are using an Elytra alongside it"]
	quest.45240C873BEAD3EF.quest_subtitle: "Boing! Boing! Boing!"
	quest.45240C873BEAD3EF.title: "&aSlime Armor"
	quest.4547F61DCD2D7B57.quest_desc: [
