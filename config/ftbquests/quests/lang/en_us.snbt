	quest.52BB3788E78BDEC5.title: "&#FF6854【Recycling】&f Battlewill Guide"
	quest.52E043CA3F3DADF1.quest_desc: ["Create turns rotational force into motion. Start with the Wrench and Engineer's Goggles, then learn to combine power, materials, and automation."]
	quest.52E043CA3F3DADF1.quest_subtitle: "&b&lAll of Create&r is based around &6&lCreate&r, a steampunk mod that lets you build contraptions and automate most things you can think of"
	quest.52E043CA3F3DADF1.title: "Welcome to Create"
	quest.52E122FDA87AFC22.quest_desc: [
		"It will wake up when the player gets close to it. It has two stages. In the second stage, the Void Slam and Leap Slam skills will be unlocked, and the skills in the first stage will be enhanced."
		"&6The skills it possesses are: space attack invalidation, gravity attack invalidation, abnormal status invalidation and body strengthening."
	]
	quest.52E122FDA87AFC22.quest_subtitle: "Bunker Keeper"
	quest.52E122FDA87AFC22.title: "Defeat the Ender Guard"
	quest.52F7B7F6FE3C861C.title: "Obtain Gingerbread"
	quest.52FB130CD9550AB3.quest_desc: [
		"&6Stellar Filaments&f make a &dStarlight Focus Crystal&f brighter, based entirely on where they're placed."
		""
		"A layer is four filaments on the same level, one in each diagonal quarter around the crystal, none in line with it, and no two stacked in the same column."
		""
		"A correct layer lights up and each layer widens and brightens the &3Focal Point's&f beam until it's visible from far away."
		""
		"Each &bConstellation&f adds its own placement rule, listed in the &bTome&f."
	]
	quest.52FB130CD9550AB3.title: "&6Stellar Filament"
