	quest.74C1BF247D821009.quest_subtitle: "Tower Erected in the Ice Field"
	quest.74F615E1EE2FC750.quest_desc: [
		"You can throw the raw minerals you dug into it for decomposition and screening without consuming anything."
		"&6For example, from 64 magic ore fragments, 102 can be screened out, which is 38 more."
	]
	quest.74F615E1EE2FC750.quest_subtitle: "One becomes three."
	quest.74F615E1EE2FC750.title: "&6【Forging Line·Extra】&r Fully Automatic Screening Machine?"
