	quest.22464F35204CBECE.title: "&7Fan Smoking Catalyst"
	quest.224C89D395703D89.quest_desc: "After a player devours an Otherworlder or another player with Gluttony or Predator, they will permanently become Steve-shaped."
	quest.224C89D395703D89.quest_subtitle: "That Time I Got Reincarnated as a Slime"
	quest.226176A1C73431B5.quest_desc: ["Assign 5 fields to a single worker."]
	quest.226176A1C73431B5.quest_subtitle: "Get To Work!"
	quest.227344A740254FF5.quest_desc: [
		"An &6Apothic Invader&r begins as an ordinary non-boss mob. If it passes the chance roll, it becomes a more dangerous, named foe with Apotheosis gear and effects; mobs that are already bosses are excluded."
		""
		"The chance is determined by the candidate's &dExistence Points (EP)&r when it spawns. EP also informs the Invader's gear tier."
		""
		"&eSpawn chance by EP&r:"
		"&7Below 1,000 EP&r: &c0%"
		"&71,000–2,999 EP&r: &b5%"
		"&73,000–5,999 EP&r: &b10%"
		"&76,000–8,999 EP&r: &b15%"
		"&79,000–14,999 EP&r: &b20%"
		"&715,000–29,999 EP&r: &b30%"
		"&730,000–49,999 EP&r: &b40%"
		"&750,000–79,999 EP&r: &b50%"
		"&780,000–140,999 EP&r: &b60%"
		"&7141,000 EP and above&r: &b70%"
		""
		"Apothic mobs can also spawn with &dSkills&r, giving them abilities beyond their stronger equipment."
	]
	quest.227344A740254FF5.quest_subtitle: "The EP bracket sets the chance of an Apothic Invader"
	quest.227344A740254FF5.title: "&6Apothic Mobs and Existence Points"
	quest.22BBE779E5DA0447.title: "{translate:\"task.BB2C3D4E5F6A7891.title\"}"
