	quest.795BDBCA3802C004.quest_subtitle: "&7Simple Fare"
	quest.79933C964312F721.quest_desc: ["Build a Sifter's Hut to take advantage of extra resources hiding in blocks."]
	quest.79933C964312F721.quest_subtitle: "Diamond in the Rough"
	quest.79B7B0488B32BC1A.quest_desc: ["The Flugel Tiara grants temporary creative flight while worn."]
	quest.79B7B0488B32BC1A.quest_subtitle: "Temporary creative flight"
	quest.79B7B0488B32BC1A.title: "Flugel Tiara"
