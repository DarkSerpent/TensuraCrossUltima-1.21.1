	]
	quest.48345B3536C27D98.quest_subtitle: "Lizardfolk Habitat"
	quest.48345B3536C27D98.title: "Swamp Tribe"
	quest.4835EBAC6D933CDB.quest_desc: [
		"Ancient Forest, a rare and dangerous ecological area, the concentration of Magicule airflow is forty times that of the normal environment.&2&lHerbalists will also be pleased to discover that there are slightly more Hippocratic herbs here than elsewhere.&r"
		"{image:ablazeaqzlcz:textures/ftb/ancient_forest.png width:200 height:100 align:center}"
		"&6Please note: Some huge trees hide maze portals in their high branches.&r"
		"Not all ancient forests have entrances to the Elf Labyrinth Dimension. If you want to find the Elf Labyrinth Tree, you may need to spend a little time!"
	]
	quest.4835EBAC6D933CDB.quest_subtitle: "The risk index is high and the EP is low (less than 8000). Please do not go!"
