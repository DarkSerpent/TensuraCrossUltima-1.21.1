	quest.76F48EB46CAF8A5D.title: "&2Road Kill"
	quest.76F6510052CBBC5D.quest_subtitle: "&7Simple Fare"
	quest.7701D3E35582F91A.quest_desc: ["Use the Eye of the Void to locate this fortress on an outer island in the End."]
	quest.7701D3E35582F91A.quest_subtitle: "Isolated Building"
	quest.7701D3E35582F91A.title: "Go to the Abandoned Fortress"
	quest.77209E7CA9027AA4.quest_desc: [
		"&6Note: Do not use skills while the cutscene is playing, as it may cause your preset skill slots to be cleared."
		""
		"Appears in the snowy mountains, the Boss will be surrounded by frozen skeleton bones."
	]
	quest.77209E7CA9027AA4.quest_subtitle: "The Frozen Wildman of the Snowy Mountains"
	quest.77224F3957EF8057.quest_desc: [
		"There are two ways to go to the Elf Dimension, one is to reincarnate as an Elf race, and your resurrection place will be in that world!"
		"In Elf Dimension, there are many elven creatures, some of which are curious and friendly towards you. Of course, there are also hostile elves."
		""
		"So how to return to the main world?"
		""
		"&6There are additional conditions for reincarnating into an elf race and returning to the main world!"
	]
	quest.77224F3957EF8057.quest_subtitle: "About the Elf World"
	quest.77224F3957EF8057.title: "Welcome to the Elf World!"
	quest.774C400118E08DB2.title: "Ogre General"
	quest.7758E6431EFDF6A6.quest_desc: [
		"If you want to return to the main world or enter the underworld, you need to enter this door."
		""
		"{image:ablazeaqzlcz:textures/ftb/hell_gate.png width:100 height:100 align:center}"
	]
	quest.7758E6431EFDF6A6.quest_subtitle: "What the hell is this place?"
	quest.77681E6F6ECDDA97.quest_desc: [
		"If you want to know the habits of this dragon"
		"[ { \"text\": \"You can learn about it through Bestiary\", \"underlined\": true, \"clickEvent\": { \"action\": \"change_page\", \"value\": \"25014047C30407BA\" } } ]"
	]
	quest.77681E6F6ECDDA97.title: "Kill an Ice Dragon"
	quest.777523E00372E128.quest_subtitle: "Absorb nearby flowers and convert them into Aura."
	quest.7775C103AE390F9C.quest_desc: [
		"The &3Lumen Array&f converts &bLiquid Starlight&f into &2Lumen&f, which is starlight tied to a single &bConstellation&f. Right-click it with a bucket of &bLiquid Starlight&f, then with a luminous flower to start filling its reserve."
		""
		"An &3Array&f locks to the first &2Lumen&f type it makes, so you'll need to build one per type. It runs fastest around half full and only supplies other devices once it holds a decent amount of lumen."
		""
		"&7&oThe flower eventually breaks, so keep spares"
	]
	quest.7775C103AE390F9C.title: "&3Lumen Array"
	quest.778CCF75E93579B4.quest_subtitle: "&6Mechanical Belts&r are useful for moving items either in a straight line or diagonally. Make sure to place a &6Shaft&r on each end so they can connect and work properly"
	quest.778CCF75E93579B4.title: "Mechanical Belt"
	quest.779A0455DC39F18D.quest_subtitle: "&7Simple Fare"
	quest.77AC927CDCDAF642.quest_subtitle: "&aA Few More Steps"
	quest.77DAE84C2DA918B8.quest_desc: [
		"How to obtain:"
		"Master Unlimited Imprisonment, Absolute Severance, Usurper, and Spacetime Travel (all four skills will be lost)."
		"Costs 5 million magicules."
		"Once these requirements are met, you can synthesize it through Lord of Wisdom's Integration."
		""
		"In multiplayer, only one player can possess this skill. This restriction can be changed using the gamerule:"
		"/gamerule yogSothothTrulyUnique"
	]
	quest.77DAE84C2DA918B8.quest_subtitle: "Requirements ↓"
	quest.77DAE84C2DA918B8.title: "&6【Advanced】&f Ultimate Skill: Yog-Sothoth, Lord of Spacetime"
	quest.7826031A16D82432.quest_subtitle: "A &6Display Board&r is basically an advanced sign that updates faster if provided with higher &6RPM&r. It's like the bulletin boards you see in train stations"
	quest.7826031A16D82432.title: "Obtain Display Board"
	quest.78465B68CA53F4C8.quest_desc: ["Dropped by the Sirens in the Acropolis"]
	quest.78465B68CA53F4C8.quest_subtitle: "Priceless"
	quest.78465B68CA53F4C8.title: "Tears of Sirens"
	quest.7870800C28A7E199.quest_desc: [
		"The Chicken Farmer’s Hut is where the Chicken Farmer will raise chickens, collect eggs, and butcher chickens for food. You will have to capture and bring in two chickens to the Chicken Farmer’s Hut, as the Chicken Farmer will not catch and bring in any chickens."
		""
		"The Chicken Farmer will only keep two chickens alive per hut level, so at level 5 they will have ten chickens."
	]
	quest.7870800C28A7E199.quest_subtitle: "Build a Chicken Farmer's Hut"
	quest.7878EDB447B7DFDA.quest_desc: [
		"&cThe next pages in this quest contain spoilers for completing the artifact requests!"
		""
		"&7&oYou've been warned"
		"{@pagebreak}"
		"- &bLooks for a mob cage&f: a spawner or trial spawner"
		"- &3Wants a quiet watcher&f: an observer"
		"- &bWants a map maker&f: a cartography table"
		"- &3Likes sound blocks&f: a note block, jukebox or bell"
		"- &bWants a decorated waving cloth&f: a banner"
		"- &3Wants a heavy forge&f: an anvil"
		"- &bLooks for a sound sensitive block&f: a sculk sensor"
		"- &3Looks for tangled webs&f: 3 cobwebs"
		"- &bWants purple crystals&f: 2 amethyst buds or clusters"
		"- &3Looks for mineral deposits&f: 2 ore blocks, no raw ore or storage blocks"
		"{@pagebreak}"
		"- &bPrefers cold clear blocks&f: 2 ice blocks"
		"- &3Desires precious gem blocks&f: 2 diamond or emerald blocks"
		"- &bLooks for signal components&f: 2 of redstone dust, redstone torches, repeaters, comparators or daylight detectors"
		"- &3Looks for lit wax lights&f: 3 candles"
		"- &bWants explosives&f: 3 TNT"
		"- &3Looks for vibrant reef blocks&f: 2 coral blocks"
		"- &bLikes blooming foliage&f: 4 flowers"
		"- &3Needs wooden trunks&f: 4 logs"
		"- &bLooks for tree foliage&f: 4 leaves"
		""
		"&7&oFlowers, logs and leaves get eaten now and then, so keep spares nearby"
		"{@pagebreak}"
		"- &bObserves fleshy undead monsters&f: 2 zombies"
		"- &3Looks for skeletal creatures&f: 2 skeletons"
		"- &bLikes aquatic creatures&f: 2 fish, squid, turtles or the like"
		"- &3Wants to be part of a raid&f: 2 pillagers, vindicators or other raiders"
		"- &bNeeds to be burned&f: fire or lava"
		"- &3Needs to be shot&f: an arrow or any other projectile"
		"- &bNeeds to be exploded&f: any explosion"
		"- &3Needs to be hit by a sharp edge&f: hit it with a sword"
		"{@pagebreak}"
		"- &bSeeks the heat of an infernal place&f: be in the Nether"
		"- &3Seeks the void of an abyssal place&f: be in the End"
		"- &bWants to reside in a terrible fortress&f: sit inside a Nether Fortress"
		"- &3Wants to hide in an underground fortress&f: sit inside a stronghold"
		"- &bWants to explore an abandoned mining area&f: sit inside a mineshaft"
		""
		"&7&oA place riddle ties the Artifact to that place, since every later riddle checks it again"
	]
	quest.789E303E30210CCA.quest_desc: [
		"In a world where magicules and existence energy shape the strength of monsters, the Gaia Guardian is an ancient being bound to Alfheim's living power. Its presence is not some clichéd trial you must overcome to advance your mastery of nature—instead, it is a formidable creature defending the force that sustains its realm. The arena and offerings are now prepared; answer its challenge, and claim the right to wield what it protects."
		""
		"&6&lPreparation:&r Clear and level the arena, then bring well-enchanted armor and a reliable weapon. Carry ample food and healing, and consider speed or resistance buffs for a prolonged battle."
		"&6&lIn the fight:&r Keep moving and watch for the guardian's purple attacks, which can inflict Wither. Do not trade blows recklessly: the guardian limits how much damage it takes at once, so wait for a safe opening and strike with care."
	]
	quest.789E303E30210CCA.title: "Defeat Gaia Guardian I"
	quest.789F501522083EDE.quest_subtitle: "&9Rare"
	quest.789F501522083EDE.title: "Catch Witherfin"
	quest.78B7C0A0CB97647C.quest_desc: [
		"A powerful existence above ordinary demons and below the Lord Demon."
		"Great demons usually possess extremely high magic power and wisdom, are able to skillfully use powerful magic and spiritual abilities, and belong to the dominant class in hell."
	]
	quest.78B7C0A0CB97647C.quest_subtitle: "Intelligent Body"
	quest.78B7C0A0CB97647C.title: "Great Demon"
	quest.78FEB8B099E20DAD.quest_subtitle: "&aA Few More Steps"
	quest.7918A54B2D2DA0B7.quest_subtitle: "The skin is very thick and very durable."
	quest.7918A54B2D2DA0B7.title: "Heavy Armored Lizard Monster"
	quest.792137DE82A20891.quest_desc: [
		"&6Note: Do not use skills while the cutscene is playing, as it may cause your preset skill slots to be cleared."
		""
		""
		"Completely invincible during attack animations, can also reflect arrows."
		"When hit outside of attack, it loses \"paralysis value\". It enters paralysis after 4 hits by default."
		"There is no damage reduction during paralysis, this is the best window for dealing damage."
		"Recovers after about 2 seconds, resetting the paralysis value."
	]
	quest.792137DE82A20891.quest_subtitle: "The Best in the Nether"
	quest.7925D6BE79C8FD12.quest_subtitle: "&aA Few More Steps"
	quest.792ED9FE45BAC2DD.quest_subtitle: "&7Common"
	quest.792ED9FE45BAC2DD.title: "Catch Herring"
