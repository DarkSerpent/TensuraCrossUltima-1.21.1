	quest.761923C73612D3D1.title: "Catch Swordfish"
	quest.7621D7B84C9D710F.quest_desc: [
		"Place the Unbound Book into the spell binding table and select the magic you have mastered to complete the binding."
		""
		"How to obtain: You can find it in the dwarf magic tutor box with a 1% chance, or in the wizard tower with a 5%~10% chance."
	]
